rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /characters/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /profile-photos/{fileName} {
      allow read: if true;
      // Simplificado para v1: cualquier usuario logueado puede subir una foto de perfil.
      // Se puede endurecer más adelante validando que fileName empiece con el propio uid.
      allow write: if request.auth != null;
    }
  }
}
